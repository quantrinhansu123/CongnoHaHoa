NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Chỉ đặt ở server/Vercel. Không dùng tiền tố NEXT_PUBLIC_ cho khóa OpenAI.
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
OPENAI_MODEL=gpt-5.4-mini

# Chỉ dùng ở máy quản trị khi chạy npm run db:import. Không đưa key này lên client/Vercel.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
IMPORT_ADMIN_EMAIL=admin@hahoanpp.vn
IMPORT_ADMIN_PASSWORD=change-this-password
IMPORT_ADMIN_NAME=Quản trị Hà Hoà
